          {
            "id": "n2",
            "label": "水墨写意",
            "style": "rounded=1;arcSize=10;whiteSpace=wrap;fontSize=14;fontColor=#5a4a1a;fillColor=#fdf6e3;strokeColor=#c9a227;",
            "w": 260,
